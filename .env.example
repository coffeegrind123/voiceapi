# Copy to .env and fill in. Never commit .env.

# Comma-separated bearer keys, each >= 24 characters (e.g. `openssl rand -hex 24`).
VOICEAPI_API_KEYS=
# Set to 1 only on a trusted network to run without keys.
VOICEAPI_ALLOW_ANONYMOUS=0

# Where clients reach the gateway; used in file URLs and llms.txt. Example: http://192.168.1.20:8080
VOICEAPI_PUBLIC_BASE_URL=
VOICEAPI_BIND=0.0.0.0
VOICEAPI_PORT=8080

# Voice (id or name) used when a client sends an OpenAI preset name such as "alloy".
VOICEAPI_DEFAULT_VOICE=

# Optional: OpenAI-compatible upstream for /v1/chat/completions passthrough (Ovis transcript polish).
VOICEAPI_CHAT_UPSTREAM=
VOICEAPI_CHAT_UPSTREAM_KEY=

# Hugging Face token (raises download rate limits; the models are public).
HF_TOKEN=

# Engine tuning.
VOICEAPI_ENGINE_PROFILE=ada24g
VOICEAPI_VOICE_TABLE_ROWS=16384
VOICEAPI_ENGINE_MAX_ACTIVE=16
# 1 = never download at startup (after the first run cached the models).
VOICEAPI_OFFLINE=0

# Worker: unload Qwen3-ASR after N idle seconds (0 = keep loaded).
VOICEAPI_WORKER_ASR_IDLE_UNLOAD_S=0

# Image tag to run (branch name or git sha published by CI).
VOICEAPI_TAG=main
